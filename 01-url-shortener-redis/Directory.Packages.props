<!--
  Central Package Management: as VERSÕES de todos os pacotes NuGet ficam aqui.
  Nos .csproj usamos só <PackageReference Include="Pacote" />, sem Version.
  Novos pacotes serão adicionados aqui conforme avançarmos nas etapas.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning: as versões abaixo valem também para dependências INDIRETAS.
      Sem isso, o Npgsql puxaria o EF Core 10.0.4 (mínimo que ele aceita) enquanto o
      pacote Design puxa o 10.0.15, gerando conflito de versão entre os projetos.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup Label="Banco de dados">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- Dependências indiretas (via Npgsql), fixadas na mesma versão do Design -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>
