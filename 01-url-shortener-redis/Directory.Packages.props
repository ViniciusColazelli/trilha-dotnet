<!--
  Central Package Management: as VERSÕES de todos os pacotes NuGet ficam aqui.
  Nos .csproj usamos só <PackageReference Include="Pacote" />, sem Version.
  Novos pacotes serão adicionados aqui conforme avançarmos nas etapas.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>
